# Copy to backend/.env
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/aqp
STORAGE_DIR=../storage
SESSION_SECRET=change-me
FRONTEND_URL=http://localhost:5173

# LLM backend: ollama (self-hosted, default), anthropic, groq, or failover
# (failover = self-hosted when it answers a probe, hosted otherwise)
LLM_BACKEND=ollama
OLLAMA_MODEL=qwen3:8b
OLLAMA_URL=http://localhost:11434
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
GENERATION_TEMPERATURE=0.7

# Hosted fallback
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Cloudflare Access service token, when OLLAMA_URL is a public tunnel rather than localhost.
# Without these the tunnel is an unauthenticated Ollama open to anyone who finds the hostname.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Novelty engine
NOVELTY_ENABLED=true
NOVELTY_SHORTLIST=10
NOVELTY_REDRAFT_BUDGET=1

# Institutional sign-in (OIDC). Google Workspace is an OIDC provider, so the issuer below is all
# that is needed for institute Google accounts.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8000/auth/callback
# Only this domain may sign in. Checked server-side on the returned claims, not just passed to
# Google as a hint. Leave blank to allow any account the provider authenticates.
ALLOWED_DOMAIN=
# Exceptions to the domain rule. Note that an *Internal* Google app blocks non-organisation
# accounts before the callback is ever reached, so this only takes effect if the consent screen is
# switched to External.
ALLOWED_EMAILS=
# Addresses granted coordinator on first sign-in. Everyone else arrives as `pending` and is granted
# a role by a coordinator in the app.
COORDINATOR_EMAILS=
# When true and no OIDC is configured, the seeded users can sign in by email. Must be false in a
# deployment: it would otherwise hand a session to anyone who knows a seeded address.
DEV_LOGIN=true

# The single course this deployment serves (plan §2, §7 scope one course). Seeded at startup,
# because there is no course-creation endpoint yet — without it a deployment has no course at all.
COURSE_CODE=CS101
COURSE_TITLE=Prototype Course
