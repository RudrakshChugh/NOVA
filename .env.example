# Copy to backend/.env
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/aqp
STORAGE_DIR=../storage
SESSION_SECRET=change-me

# LLM backend: ollama (self-hosted, default) or anthropic (hosted, needs ANTHROPIC_API_KEY)
LLM_BACKEND=ollama
OLLAMA_MODEL=qwen3:8b
OLLAMA_URL=http://localhost:11434
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
GENERATION_TEMPERATURE=0.7

# Institutional SSO (OIDC). When unset and DEV_LOGIN=true, POST /auth/login {"email"} for a seeded user.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8000/auth/callback
DEV_LOGIN=true
