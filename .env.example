# Copy to backend/.env
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/aqp
STORAGE_DIR=../storage
SESSION_SECRET=change-me
FRONTEND_URL=http://localhost:5173

# LLM backend: ollama (self-hosted, default), anthropic, groq, or failover
# (failover = self-hosted when it answers a probe, hosted otherwise)
LLM_BACKEND=ollama
OLLAMA_MODEL=qwen3:8b
OLLAMA_URL=http://localhost:11434
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
GENERATION_TEMPERATURE=0.7

# Hosted fallback
GROQ_API_KEY=
# Groq retires models on a schedule. If a run fails with a model error, the message lists the
# names the key can reach; set one of them here.
GROQ_MODEL=openai/gpt-oss-120b
# Cloudflare Access service token, when OLLAMA_URL is a public tunnel rather than localhost.
# Without these the tunnel is an unauthenticated Ollama open to anyone who finds the hostname.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Novelty engine
NOVELTY_ENABLED=true
NOVELTY_SHORTLIST=10
NOVELTY_REDRAFT_BUDGET=1
# Past-year questions shown to the model before it drafts (0 turns this off), and how close to
# the blueprint row one has to be to be shown.
NOVELTY_AVOID_K=3
NOVELTY_AVOID_MIN_SIMILARITY=0.35
# Also audit a draft against this run's earlier questions and the published bank. Normal runs
# only; evaluation runs are always measured against past papers alone.
NOVELTY_INTERNAL_CHECK=true
SIBLING_PROMPT_LIMIT=5
# A blueprint row is skipped, not drafted, when the best passage found for it is less similar
# than this: the material does not cover the row's concept. 0 switches the check off.
RETRIEVAL_MIN_SIMILARITY=0.40
# After drafting, list the facts in the answer key and verify, word for word, the sentence of
# the material behind each. One extra model call per question; an unsupported answer is
# rewritten up to EVIDENCE_REDRAFT_BUDGET times.
CLAIM_CHECK_ENABLED=true
EVIDENCE_REDRAFT_BUDGET=1
# Extra attempts when a reply cannot be read at all (not JSON, no question in it).
MALFORMED_RETRY_BUDGET=2

# Institutional sign-in (OIDC). Google Workspace is an OIDC provider, so the issuer below is all
# that is needed for institute Google accounts.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8000/auth/callback
# Only this domain may sign in. Checked server-side on the returned claims, not just passed to
# Google as a hint. Leave blank to allow any account the provider authenticates.
ALLOWED_DOMAIN=
# Exceptions to the domain rule. Note that an *Internal* Google app blocks non-organisation
# accounts before the callback is ever reached, so this only takes effect if the consent screen is
# switched to External.
ALLOWED_EMAILS=
# Addresses admitted as platform administrators on first sign-in: they create subjects, name
# each subject's coordinator, and admit everyone else. Every other address arrives as
# `pending` and is admitted in the app, then added to a subject by that subject's coordinator.
COORDINATOR_EMAILS=
# When true and no OIDC is configured, the seeded users can sign in by email. Must be false in a
# deployment: it would otherwise hand a session to anyone who knows a seeded address.
DEV_LOGIN=true

# The single course this deployment serves (plan §2, §7 scope one course). Seeded at startup,
# because there is no course-creation endpoint yet — without it a deployment has no course at all.
# The first subject, created at startup so a fresh deployment has something to open. Further
# subjects are created in the app by an administrator.
COURSE_CODE=CS101
COURSE_TITLE=Prototype Course
